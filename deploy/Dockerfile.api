# The site's API, and nothing else.
#
# It carries no engine binary and builds no engine: the database is its own
# image (`Dockerfile.db`), reached over the compose network. That is what keeps
# this image buildable in a couple of minutes while the one that compiles a
# vendored RocksDB is rebuilt only when the engine revision moves.
#
# There is no start script. Everything this needs — the node's address, the
# namespace, the bind address, and the two identities it signs in as — arrives
# through the environment, so the container runs one process and Docker does the
# supervising that a shell used to do badly.

# ── build ───────────────────────────────────────────────────────────────────
FROM rust:1.98-slim-bookworm AS build

# `git` because the client SDK is a git dependency and cargo is told to fetch
# with the CLI (see .cargo/config.toml).
#
# There is no `openssh-client` and no forwarded agent any more. This build used
# to install one, write a `known_hosts`, and rewrite every `https://github.com/`
# URL to SSH, because `TessariDB-sdk-rust` was private and the fetch had to be
# authenticated. That repository is public now — checked 2026-09-02, an
# anonymous request answers 200 — so the lockfile's own HTTPS URL is fetched as
# written, and a deploy needs no key at all.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY .cargo ./.cargo
COPY crates ./crates
RUN cargo build --release --workspace --locked

# ── run ─────────────────────────────────────────────────────────────────────
FROM debian:bookworm-slim

# `curl` for the health check below. The uid matches the database image's, which
# costs nothing and means the two never disagree about who owns what if a future
# change hands them a shared path.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tini curl \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 --home /srv docs

COPY --from=build /build/target/release/docs /usr/local/bin/docs

USER docs
WORKDIR /srv
ENV TESSARIDB_ADDRESS=db:7654 \
    DOCS_BIND=0.0.0.0:8080 \
    DOCS_NAMESPACE=v0_0_1_alpha \
    RUST_LOG=info

EXPOSE 8080

# tini even for one process, because that process is PID 1 — and PID 1 does not
# receive a signal it has no handler for. Without it `docker stop` would wait
# out its grace period and then kill this rather than stop it.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/usr/local/bin/docs", "serve"]

# Answers only if it can reach the store and sign in, so this is the check that
# proves the pair actually talk — the database's own check can only prove that
# it is listening.
HEALTHCHECK --interval=15s --timeout=3s --start-period=20s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8080/api/health || exit 1
