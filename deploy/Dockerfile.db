# The database, on its own.
#
# It is a separate image from the API for two reasons that have nothing to do
# with each other. The first is failure: when both ran in one container a script
# supervised them, and either one exiting took the other down — so an API crash
# stopped the database. The second is the build: this image takes forty minutes
# because the storage engine compiles a vendored RocksDB from source, and the
# API changes far more often than the engine does. Separated, the API rebuilds
# in a couple of minutes and this image is rebuilt only when the engine moves.
#
# What it costs: the wire protocol between the two carries no TLS, so splitting
# them puts an unencrypted database protocol on a network. That network is
# declared `internal` in the compose file and nothing publishes a port onto it.

# ── the node ────────────────────────────────────────────────────────────────
# The build argument is a branch, a tag, or a commit of the engine repository.
# Name a commit for a deployment: it is what makes a rebuild reproducible, and
# it is also the cache key for this stage, so moving it is what makes a rebuild
# actually fetch the engine again.
FROM rust:1.98-slim-bookworm AS engine
ARG TESSARIDB_REF=dev
# `clang` and `libclang-dev` because the storage engine's bindings are generated
# by bindgen, which loads libclang at build time and panics without it; the C++
# toolchain because the same crate compiles a vendored RocksDB from source.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      git ca-certificates openssh-client \
      clang libclang-dev build-essential \
 && rm -rf /var/lib/apt/lists/*
RUN mkdir -p -m 0700 /root/.ssh \
 && ssh-keyscan -t ed25519 github.com >> /root/.ssh/known_hosts 2>/dev/null
WORKDIR /engine
# Fetched rather than cloned, because `git clone --branch` takes a branch or a
# tag and refuses a commit — and a commit is exactly what a deployment should
# name. `fetch` accepts all three, so this line does not care which one it was
# given. `rev-parse` then puts the resolved commit in the build log, where the
# question "which engine is this image running" is answered without guessing.
#
# The engine repository is private, so the agent is forwarded in for the
# duration of this one instruction. Nothing is written to a layer, so the image
# carries no credential.
RUN --mount=type=ssh git init -q . \
 && git remote add origin git@github.com:TessariDB/TessariDB.git \
 && git fetch -q --depth 1 origin "${TESSARIDB_REF}" \
 && git checkout -q FETCH_HEAD \
 && echo "engine revision: $(git rev-parse HEAD)" \
 && cargo build --release -p tessari-cli --bin tessaridb --locked

# ── run ─────────────────────────────────────────────────────────────────────
FROM debian:bookworm-slim

# uid 10001 and the name must match the API image's history and, more to the
# point, the ownership of the host directory bound over /var/lib/tessaridb — a
# bind mount presents the host's ownership and shadows whatever this image sets,
# so a different uid here is a store the node cannot open, reported as a
# database fault rather than as a permissions one.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tini \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 --home /var/lib/tessaridb docs \
 && mkdir -p /var/lib/tessaridb \
 && chown docs:docs /var/lib/tessaridb

COPY --from=engine /engine/target/release/tessaridb /usr/local/bin/tessaridb
COPY deploy/start-db.sh /usr/local/bin/start-db
RUN chmod +x /usr/local/bin/start-db

USER docs
ENV TESSARIDB_STORE=/var/lib/tessaridb/store \
    TESSARIDB_ADDRESS=0.0.0.0:7654 \
    DOCS_NAMESPACE=v0_0_1_alpha \
    RUST_LOG=info

VOLUME ["/var/lib/tessaridb"]
EXPOSE 7654

# tini, because the start script backgrounds the node and supervises it, and a
# shell as PID 1 neither reaps nor forwards signals — `docker stop` would then
# kill the store rather than let it close.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/usr/local/bin/start-db"]

# Two conditions, and the second is the one that matters to the API. The port
# being open says the node is listening. The marker says the accounts have been
# declared — without it the API could connect to a store that is up but still
# has no users, sign in anonymously, and be refused a moment later when the
# owner's declaration closes the store.
#
# What this does NOT prove: that the store opened without corruption, or that
# any particular namespace exists. A closed store refuses anonymous sessions, so
# a deeper check would need credentials and an Argon2 verification every fifteen
# seconds; the API's own /api/health is the check that proves the pair talk.
HEALTHCHECK --interval=15s --timeout=3s --start-period=60s --retries=3 \
  CMD bash -c '[ -f /tmp/store-ready ] && exec 3<>/dev/tcp/127.0.0.1/${TESSARIDB_ADDRESS##*:}' || exit 1
