# Copy to deploy/.env and set the three passwords before the first start.
#
# They are read only on a **fresh** store: the owner's declaration closes the
# store, and a closed store refuses the anonymous session that would declare
# another user. So these values are what the accounts are created with the first
# time, and are the values the site signs in with every time after.
#
# Two things declare them now, where a shell script inside the database image
# used to. The **owner** is declared by the engine itself, from
# `TESSARIDB_INITIAL_USER` and `TESSARIDB_INITIAL_PASSWORD` in `compose.yaml`.
# The **reader** and the **editor**, and the namespace and database they live
# in, are the `init` service — behind a profile, run by hand once:
#
#   docker compose -f deploy/compose.yaml --env-file deploy/.env \
#     --profile init run --rm init
#
# Changing a password here later does not change it in the store. Sign in as the
# owner and redeclare the user.
#
# Keep the owner password. There is no back door: an anonymous session cannot
# re-open a closed store by dropping its last user, so a lost owner password is
# a restore from backup rather than a recovery.

# Declares the other two, and is used for nothing else.
DOCS_OWNER_PASSWORD=

# The account the public read path runs as. A viewer: the store refuses a write
# on it whatever the API believes it is doing.
DOCS_READER_PASSWORD=

# Writes. The ingest at first start, and the API's PUT and DELETE.
DOCS_EDITOR_PASSWORD=

# Name the two service accounts after the namespace they serve, and rename them
# whenever DOCS_NAMESPACE moves.
#
# Not a style preference. A user's name is unique across the **store**, and both
# are declared with `IF NOT EXISTS`, so pointing the deployment at a new
# namespace and re-running `--profile init` reports `ok` six times and changes
# nothing — the accounts keep the reach they were first given, and the API is
# then refused with *"<namespace> is outside this user's namespace and
# database"*. It reads like a permissions bug and is a naming one.
#
# Versioned names also keep the previous namespace servable, which is what makes
# pointing DOCS_NAMESPACE back a real rollback rather than a hope.
DOCS_READER_USER=reader_v0_0_2
DOCS_EDITOR_USER=editor_v0_0_2

# Where the store lives on the host. A path, not a named volume, so that a
# backup is a copy of a directory.
DOCS_STORE_PATH=./store

# Where the front end is published. Loopback, because what faces the public is
# a TLS terminator on the host; widen it only if nothing fronts this.
DOCS_WEB_BIND=127.0.0.1:3000

# Who may edit the site through the API.
#
# Not a database user. The database's own accounts above are two service
# identities that nobody types: the API reads as one and writes as the other.
# This is a person. They POST to /api/session with these credentials and get a
# token that works for a day; the write routes accept the token and nothing
# else, so the database's password never travels with an edit.
#
# Seeded into the store on every start, so changing it here changes it there.
# Twelve characters minimum, refused below that.
#
# Give the person their own name rather than reusing `editor`, which is the
# database's *service* account above. The two live in different places and would
# hold different passwords, and one name over both is how they get confused.
DOCS_ADMIN_USER=your-name
DOCS_ADMIN_PASSWORD=

# The engine is no longer built here, so there is no revision to name. The
# database is `tessaridb/tessaridb`, pulled from Docker Hub, and the version is
# pinned in `compose.yaml` rather than set from here — moving it is a decision
# about an existing store's on-disk format, not a deployment knob, and it should
# be made with a backup already taken.

# The documentation version, which is the store's namespace.
DOCS_NAMESPACE=v0_0_2_alpha
